# Copy this file to .env and fill in the values.

# Port for the web server
PORT=3000

# Telegram notifications for dispatchers (optional).
# 1. Create a bot with @BotFather and paste its token here.
# 2. Add the bot to your dispatchers' group, send any message there,
#    then open https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id (it starts with -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password for the dispatcher page at /admin (leave empty to disable it).
ADMIN_PASSWORD=

# Set to 1 when running behind nginx / a load balancer, so rate limits see the real client IP.
TRUST_PROXY=0
